{
  "_meta": {
    "version": "1",
    "updated": "2026-10-15",
    "note": "WAF fingerprints + misconfiguration/info-disclosure checks. Edit and re-run with --signatures, drop at ~/.ghostpress/signatures.json, or refresh via 'ghostpress update' - no rebuild required. 'mode' is the MINIMUM detection mode a check runs in (passive runs always; mixed runs in mixed+aggressive; aggressive runs only in aggressive)."
  },
  "waf": [
    {
      "vendor": "Cloudflare",
      "confidence": 90,
      "condition": "or",
      "matchers": [
        {"where": "header", "name": "Server", "contains": "cloudflare"},
        {"where": "header", "name": "CF-RAY"},
        {"where": "header", "name": "CF-Cache-Status"},
        {"where": "cookie", "contains": "__cf"}
      ]
    },
    {
      "vendor": "Sucuri CloudProxy",
      "confidence": 90,
      "condition": "or",
      "matchers": [
        {"where": "header", "name": "X-Sucuri-ID"},
        {"where": "header", "name": "X-Sucuri-Cache"},
        {"where": "header", "name": "Server", "contains": "Sucuri"},
        {"where": "body", "contains": "Sucuri WebSite Firewall"}
      ]
    },
    {
      "vendor": "AWS CloudFront/WAF",
      "confidence": 70,
      "condition": "or",
      "matchers": [
        {"where": "header", "name": "X-Amz-Cf-Id"},
        {"where": "header", "name": "X-Amzn-RequestId"},
        {"where": "header", "name": "Via", "contains": "cloudfront"},
        {"where": "header", "name": "Server", "contains": "awselb"}
      ]
    },
    {
      "vendor": "Akamai",
      "confidence": 85,
      "condition": "or",
      "matchers": [
        {"where": "header", "name": "Server", "contains": "AkamaiGHost"},
        {"where": "header", "name": "X-Akamai-Transformed"}
      ]
    },
    {
      "vendor": "Imperva Incapsula",
      "confidence": 90,
      "condition": "or",
      "matchers": [
        {"where": "header", "name": "X-Iinfo"},
        {"where": "header", "name": "X-CDN", "contains": "Incapsula"},
        {"where": "cookie", "contains": "incap_ses"},
        {"where": "cookie", "contains": "visid_incap"}
      ]
    },
    {
      "vendor": "ModSecurity",
      "confidence": 70,
      "condition": "or",
      "matchers": [
        {"where": "header", "name": "Server", "contains": "Mod_Security"},
        {"where": "header", "name": "Server", "contains": "mod_security"},
        {"where": "body", "contains": "This error was generated by Mod_Security"},
        {"where": "body", "contains": "Mod_Security Action"}
      ]
    },
    {
      "vendor": "Wordfence",
      "confidence": 80,
      "condition": "or",
      "matchers": [
        {"where": "body", "contains": "Generated by Wordfence"},
        {"where": "body", "contains": "This response was generated by Wordfence"},
        {"where": "body", "contains": "Your access to this site has been limited by the site owner"}
      ]
    },
    {
      "vendor": "F5 BIG-IP ASM",
      "confidence": 80,
      "condition": "or",
      "matchers": [
        {"where": "cookie", "contains": "BIGipServer"},
        {"where": "header", "name": "Server", "contains": "BigIP"},
        {"where": "header", "name": "Server", "contains": "BIG-IP"},
        {"where": "body", "contains": "The requested URL was rejected"}
      ]
    },
    {
      "vendor": "Fortinet FortiWeb",
      "confidence": 85,
      "condition": "or",
      "matchers": [
        {"where": "header", "name": "Server", "contains": "FORTIWAFSvr"},
        {"where": "cookie", "contains": "FORTIWAFSID"}
      ]
    },
    {
      "vendor": "Barracuda",
      "confidence": 80,
      "condition": "or",
      "matchers": [
        {"where": "cookie", "contains": "barra_counter_session"},
        {"where": "header", "name": "Server", "contains": "Barracuda"}
      ]
    },
    {
      "vendor": "DDoS-Guard",
      "confidence": 85,
      "condition": "or",
      "matchers": [
        {"where": "header", "name": "Server", "contains": "ddos-guard"},
        {"where": "cookie", "contains": "__ddg"}
      ]
    }
  ],
  "misconfig": [
    {
      "id": "cors-origin-reflection",
      "name": "CORS reflects an arbitrary Origin with credentials",
      "severity": "high",
      "mode": "aggressive",
      "reference": "https://developer.mozilla.org/en-US/docs/Web/HTTP/CORS",
      "requests": [
        {
          "method": "GET",
          "paths": ["wp-json/", "wp-json/wp/v2/types"],
          "headers": {"Origin": "https://ghostpress.invalid"},
          "match": {
            "headerReflect": {"name": "Access-Control-Allow-Origin", "of": "Origin"},
            "headerContains": {"Access-Control-Allow-Credentials": "true"}
          }
        }
      ]
    },
    {
      "id": "env-file-exposed",
      "name": ".env environment file exposed (may leak credentials)",
      "severity": "critical",
      "mode": "mixed",
      "requests": [
        {
          "method": "GET",
          "paths": [".env", ".env.local", ".env.production", ".env.development"],
          "match": {
            "status": [200],
            "bodyRegex": "(?m)^\\s*[A-Z][A-Z0-9_]*\\s*=",
            "notContentType": "text/html"
          }
        }
      ]
    },
    {
      "id": "git-config-exposed",
      "name": "Exposed .git repository (source/secret disclosure)",
      "severity": "high",
      "mode": "mixed",
      "requests": [
        {
          "method": "GET",
          "paths": [".git/config"],
          "match": {"status": [200], "bodyContains": ["[core]"], "notContentType": "text/html"}
        },
        {
          "method": "GET",
          "paths": [".git/HEAD"],
          "match": {"status": [200], "bodyContains": ["ref: refs/"], "notContentType": "text/html"}
        }
      ]
    },
    {
      "id": "missing-security-headers",
      "name": "Missing security headers",
      "severity": "low",
      "mode": "passive",
      "source": "homepage",
      "match": {
        "headerMissing": [
          "Content-Security-Policy",
          "Strict-Transport-Security",
          "X-Frame-Options",
          "X-Content-Type-Options"
        ]
      }
    },
    {
      "id": "phpinfo-exposed",
      "name": "phpinfo() page exposed (environment disclosure)",
      "severity": "high",
      "mode": "mixed",
      "requests": [
        {
          "method": "GET",
          "paths": ["phpinfo.php", "info.php", "php_info.php", "test.php"],
          "match": {
            "status": [200],
            "bodyContains": ["PHP Version", "System", "Build Date"],
            "bodyCondition": "and"
          }
        }
      ]
    },
    {
      "id": "insecure-cookies",
      "name": "Session cookie missing security flags",
      "severity": "low",
      "mode": "passive",
      "source": "homepage",
      "match": {
        "insecureCookie": {
          "nameContains": "",
          "require": ["HttpOnly", "Secure", "SameSite"]
        }
      }
    },
    {
      "id": "db-repair-exposed",
      "name": "Database repair page accessible (/wp-admin/maint/repair.php)",
      "severity": "medium",
      "mode": "mixed",
      "reference": "https://developer.wordpress.org/advanced-administration/upgrade/upgrading-older-versions/",
      "requests": [
        {
          "method": "GET",
          "paths": ["wp-admin/maint/repair.php"],
          "match": {"status": [200], "bodyContains": ["WordPress", "repair"], "bodyCondition": "and"}
        }
      ]
    },
    {
      "id": "oembed-proxy-ssrf",
      "name": "oEmbed proxy endpoint present (SSRF surface)",
      "severity": "medium",
      "mode": "mixed",
      "reference": "https://wpscan.com/blog/",
      "requests": [
        {
          "method": "GET",
          "paths": ["wp-json/oembed/1.0/proxy"],
          "match": {"bodyContains": ["rest_missing_callback_param"]}
        }
      ]
    },
    {
      "id": "wp-config-leak",
      "name": "wp-config variant leaking database credentials",
      "severity": "critical",
      "mode": "mixed",
      "requests": [
        {
          "method": "GET",
          "paths": [
            "wp-config.php.bak",
            "wp-config.php.old",
            "wp-config.php.orig",
            "wp-config.php.save",
            "wp-config.php.swp",
            "wp-config.php~",
            "wp-config.php.txt",
            "wp-config.php.dist",
            "wp-config.inc",
            "wp-config.php.original",
            ".wp-config.php.swp"
          ],
          "match": {
            "status": [200],
            "bodyContains": ["DB_PASSWORD", "DB_NAME"],
            "bodyCondition": "or",
            "notContentType": "text/html"
          }
        }
      ]
    }
  ]
}
